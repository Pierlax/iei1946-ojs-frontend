# =============================================================
# Frontend env (loaded by Vite — must be VITE_ prefixed to be
# exposed to client code, kept WITHOUT secrets).
# =============================================================
VITE_OJS_BASE_URL=http://204.216.215.234/ojs
VITE_OJS_JOURNAL_PATH=iei

# Set VITE_OJS_DIRECT=1 to bypass the Vercel proxy and call OJS
# directly from the browser. Useful for local dev pointing at an
# HTTP-only OJS. In Vercel production, leave unset (the browser
# would block HTTPS->HTTP fetches anyway).
# VITE_OJS_DIRECT=1
# VITE_OJS_API_TOKEN=paste-only-for-local-dev-when-DIRECT=1

# =============================================================
# Vercel serverless proxy env (server-side — NEVER prefixed with
# VITE_, so it stays out of the client bundle).
# Set these in the Vercel dashboard for Production / Preview.
# =============================================================
OJS_BASE_URL=http://204.216.215.234/ojs
OJS_JOURNAL_PATH=iei
# Generated in OJS: Profile -> API Key -> "Generate new API key"
OJS_API_TOKEN=
